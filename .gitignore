# Test-harness dependency only. tools/run-selftests.js and the two live-DOM passes
# need jsdom; install it with `npm install jsdom --no-save` before running them.
node_modules/

# Per-machine Claude Code settings. The shared ones live in .claude/settings.json.
.claude/settings.local.json

# Python bytecode from tools/
__pycache__/

# dist/ is deliberately NOT ignored. It is the copy-me-into-another-project folder, and a
# folder you have to build before you can copy it is not one you can copy. Both files in
# it are build artifacts of src/build-doc.json and tools/build-dist.py, kept in the repo
# for the same reason ch-config-tool.html is.
